{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "name-the-players",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "name-the-players",
      // Replace with the id printed by `npx wrangler d1 create name-the-players`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Per-IP brakes (free on every plan): profiles, reports, rooms… and sign-in e-mails.
  "ratelimits": [
    { "name": "WRITE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "EMAIL_LIMIT", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
    { "name": "ADMIN_LIMIT", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
  ],
  "triggers": { "crons": ["*/30 * * * *"] },
  "observability": { "enabled": true }
}
