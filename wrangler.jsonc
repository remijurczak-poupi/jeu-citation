{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "name-the-players",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker renders the pages search engines index (home, /quiz, /league, /fr/…), robots.txt and sitemaps.
    "run_worker_first": [
      "/api/*", "/", "/robots.txt", "/sitemap.xml",
      "/sitemap-en.xml", "/sitemap-fr.xml", "/sitemap-de.xml", "/sitemap-es.xml", "/sitemap-it.xml", "/sitemap-pt.xml",
      "/quiz", "/quiz/*", "/league/*",
      "/fr", "/fr/*", "/de", "/de/*", "/es", "/es/*", "/it", "/it/*", "/pt", "/pt/*"
    ]
  },
  // Uncomment once the domain is chosen: other hosts (workers.dev, previews) are then kept out of Google.
  // "vars": { "CANONICAL_ORIGIN": "https://example.com" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "name-the-players",
      // Replace with the id printed by `npx wrangler d1 create name-the-players`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
